# Copy to .env.local and fill in. Values per environment are in Vercel's
# project settings; ask the team for local ones.

# Which environment this build is: local | development | staging | production
NEXT_PUBLIC_APP_ENV=local

# The API, including /api/v1, e.g. https://api.stg.theguardians.world/api/v1
NEXT_PUBLIC_API_URL=

# Sent as X-Api-Key on every API call
NEXT_PUBLIC_X_API_KEY=

# Maps and place search (location pickers, the circles map)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Front-end error reporting; leave empty locally to turn it off
NEXT_PUBLIC_SENTRY_DSN=
